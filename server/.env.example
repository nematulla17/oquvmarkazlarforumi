# @BotFather dan olingan bot tokeni
TELEGRAM_BOT_TOKEN=
# Sotuv bo‘limi guruhining chat ID si (masalan -1001234567890). Botni guruhga admin qilib qo‘shing.
TELEGRAM_CHAT_ID=
# Port (ixtiyoriy)
PORT=3000
# Meta Pixel va Conversions API (Events Manager → Pixel → Settings → Generate access token)
META_PIXEL_ID=
META_CAPI_TOKEN=
# Faqat test paytida (Events Manager → Test events kodi), prodda bo‘sh qoldiring
META_TEST_EVENT_CODE=
# amoCRM (Sozlamalar → Integratsiyalar → Ключи и доступы → Долгосрочный токен)
AMOCRM_BASE_URL=
AMOCRM_TOKEN=
# Ixtiyoriy: standart — "forum hamkorlar" / "YANGI LID"
AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID=
# Meta System User token (leads_retrieval, ads_management) va instant forma ID lari (vergul bilan)
META_SYSTEM_USER_TOKEN=
META_LEADGEN_FORM_IDS=
META_LEADGEN_POLL_SEC=120
# Birinchi ishga tushishda necha soat orqaga qarab boyitiladi (standart 72)
META_LEADGEN_BACKFILL_HOURS=72
# Har aylanishda necha soat orqaga qaraladi (server uxlab qolsa lid yo‘qolmasligi uchun)
META_LEADGEN_WINDOW_HOURS=6
# Sotuv dashboardi (/dashboard): HTTP Basic auth. Parol bo‘sh bo‘lsa dashboard 503 qaytaradi.
DASHBOARD_USER=forum
DASHBOARD_PASSWORD=
# ROAS hisoblash uchun dollar kursi (so‘m), standart 12800
USD_UZS=12800
